# Copie este arquivo para .env e preencha com suas credenciais reais.
# O arquivo .env é ignorado pelo Git e nunca deve ser compartilhado.

# CPF do consultante cadastrado no PJe (somente números, sem pontos ou traços)
TJMT_CPF=

# Senha do PJe do consultante
TJMT_SENHA=

# Senha do PJe 2º grau. No TJMT o 1º e o 2º grau têm logins separados.
# Se ficar vazia, usa a TJMT_SENHA também no 2º grau.
TJMT_SENHA_2GRAU=

# URL do WSDL do MNI no TJMT (normalmente não precisa mudar)
TJMT_WSDL_URL=https://pje.tjmt.jus.br/pje/intercomunicacao?wsdl

# URL do WSDL do MNI da 2ª instância (PJe 2º grau)
TJMT_WSDL_URL_2GRAU=https://pje2.tjmt.jus.br/pje2/intercomunicacao?wsdl

# Timeout em segundos para cada requisição ao webservice
TJMT_TIMEOUT=60

# Intervalo mínimo (segundos) entre requisições ao TJMT. Aumente para ser mais
# gentil com o tribunal em downloads longos; diminua (mín. ~1) se tiver pressa.
TJMT_INTERVALO_SEGUNDOS=3

# --- Acesso ao painel (login) ---
# Em produção (servidor público) preencha os três abaixo. Se PAINEL_SENHA ficar
# vazia, o login é desligado (uso local). SECRET_KEY: string longa e aleatória.
SECRET_KEY=
PAINEL_USUARIO=
PAINEL_SENHA=

# --- Inteligência Artificial (resumos dos processos) ---

# Chave de API da Anthropic (Claude). Obtenha em console.anthropic.com
LLM_API_KEY=

# Modelo a usar. Padrão: claude-opus-4-7 (mais capaz).
# Alternativa mais barata para alto volume: claude-sonnet-4-6
LLM_MODEL=claude-opus-4-7

# --- Carteira (descoberta dos processos do advogado) ---
# Nome exatamente como aparece nas publicações do DJEN e a OAB principal.
# A atuação é confirmada pela OAB (número + UF), nunca pelo nome.
CARTEIRA_ADVOGADO_NOME=
CARTEIRA_OAB_NUMERO=
CARTEIRA_OAB_UF=

# Caminho do banco SQLite (padrão: dados/controladoria.db)
CONTROLADORIA_BANCO=
